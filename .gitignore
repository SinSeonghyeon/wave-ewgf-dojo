# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Local scratch: session notes, experiments, generated images. Never committed.
# Put persistent docs in .agents/docs/ instead.
.sandbox/

# Local Claude Code environment (personal permission settings, skill links). CLAUDE.md itself is committed (one-line @AGENTS.md import).
.claude/

# Local Codex / other agent state
.codex/

# Node / tooling leftovers (the project has no dependencies; guard against accidental installs)
node_modules/
npm-debug.log*
*.log

# Wrangler local state (worker/ deploy cache)
.wrangler/
